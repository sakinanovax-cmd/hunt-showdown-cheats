# Production site URL — required for canonical URLs, sitemap, RSS, and Open Graph.
# Local dev (default if unset): http://localhost:8080
# GitHub Pages example:
# NEXT_PUBLIC_SITE_URL=https://YOUR_GITHUB_USERNAME.github.io/hunt-showdown-cheats-site

# GitHub Actions sets GITHUB_REPOSITORY automatically during deploy.
# For manual gh-pages builds:
# GITHUB_PAGES=true
# GITHUB_REPO_NAME=hunt-showdown-cheats-site
# GITHUB_ACTOR=YOUR_GITHUB_USERNAME
